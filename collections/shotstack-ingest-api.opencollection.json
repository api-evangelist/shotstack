{
  "opencollection": "1.0.0",
  "info": {
    "name": "Shotstack Create Ingest API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Ingest",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List sources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.shotstack.io/ingest/v1/sources"
          },
          "docs": "List sources"
        },
        {
          "info": {
            "name": "Ingest a source from a URL",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.shotstack.io/ingest/v1/sources",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Queue a source file (video, image, audio, or font) to be fetched from a URL, stored, and optionally transformed into renditions or transcribed."
        },
        {
          "info": {
            "name": "Get a source",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.shotstack.io/ingest/v1/sources/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The source ID."
              }
            ]
          },
          "docs": "Get a source"
        },
        {
          "info": {
            "name": "Delete a source",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.shotstack.io/ingest/v1/sources/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The source ID."
              }
            ]
          },
          "docs": "Delete a source"
        },
        {
          "info": {
            "name": "Request a direct upload",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.shotstack.io/ingest/v1/upload"
          },
          "docs": "Request a signed URL to upload a source file directly to Shotstack storage."
        }
      ]
    }
  ],
  "bundled": true
}